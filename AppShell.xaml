<?xml version="1.0" encoding="UTF-8" ?>

<Shell x:Class="ExamForge.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ExamForge.Views"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.BackgroundColor="{StaticResource AzulOscuro}"
       Shell.TitleColor="White">

    <ShellContent Title="Portal" ContentTemplate="{DataTemplate views:PortalPage}" Route="portal" />
    <ShellContent Title="Inicio" ContentTemplate="{DataTemplate views:InicioPage}" Route="inicio" />
</Shell>