<?xml version="1.0" encoding="utf-8" ?>
<!--
  InicioPage (ventana 2: portal de cursos). Navbar con perfil y Salir, bienvenida, lista de cursos (cards) y footer.
  Card: siglas, título, desplegable de asignaturas y gráfico de queso. Las casillas y edición están siempre disponibles.
  "+" abre el popup de curso; "Eliminar" borra los cursos marcados.
-->
<ContentPage x:Class="ExamForge.Views.InicioPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:ExamForge.Views.Componentes"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto">
        <comp:NavbarView MostrarSesion="True" PerfilClicked="PerfilClicked" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Padding="16,12" RowSpacing="10">
            <Label x:Name="BienvenidaLabel" Style="{StaticResource Titulo}" Margin="0,0,0,12" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="Mis cursos" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"
                    TextColor="{StaticResource Texto}" />
                <ImageButton x:Name="EliminarSeleccionButton" Grid.Column="1" Source="delete.png" IsVisible="False"
                    WidthRequest="48" HeightRequest="40"
                    Padding="8" Aspect="AspectFit" Clicked="EliminarSeleccionClicked" />
                <Button Grid.Column="2" Text="+" FontSize="22" WidthRequest="48"
                    Style="{StaticResource BotonPequenoAcento}" Clicked="AnadirClicked" />
            </Grid>

            <CollectionView x:Name="ListaCursos" Grid.Row="2" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay cursos creados…" HorizontalTextAlignment="Center" VerticalOptions="Center"
                        TextColor="{StaticResource Texto}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Tarjeta}" Margin="0,6">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                <Grid ColumnDefinitions="Auto,40,Auto" ColumnSpacing="0">
                                    <CheckBox Opacity="1" IsEnabled="True" CheckedChanged="SeleccionCambiada"
                                        IsChecked="{Binding Seleccionado, Mode=TwoWay}" Color="{StaticResource AzulOscuro}"
                                        VerticalOptions="Center" />
                                    <ImageButton Grid.Column="1" Source="edit.png" Clicked="EditarClicked" IsVisible="True"
                                        WidthRequest="40" HeightRequest="40" Padding="4,8,12,8"
                                        BackgroundColor="Transparent" Aspect="AspectFit"
                                        VerticalOptions="Center" />
                                    <Border Grid.Column="2" BackgroundColor="{StaticResource AzulOscuro}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8" Padding="8,1" VerticalOptions="Center">
                                        <Label Text="{Binding Siglas}" TextColor="White" FontAttributes="Bold" FontSize="16" />
                                    </Border>
                                </Grid>

                                <Label Grid.Row="1" Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16"
                                    MaxLines="2" LineBreakMode="WordWrap" TextColor="{StaticResource Texto}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="CursoTapped" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <VerticalStackLayout Grid.Row="2" Spacing="6">
                                    <Button Text="{Binding TextoDesplegable, StringFormat='Asignaturas {0}'}"
                                        BackgroundColor="{StaticResource AzulClaro}" TextColor="{StaticResource AzulOscuro}"
                                        FontSize="16" FontAttributes="Bold" Padding="12,6" CornerRadius="10"
                                        HorizontalOptions="Start" Clicked="DesplegarClicked" />

                                    <VerticalStackLayout IsVisible="{Binding Desplegado}" Spacing="2">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding NombresAsignaturas}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BackgroundColor="#B0C4DE" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8" Padding="8,4" Margin="0,2">
                                                        <Label Text="{Binding .}" TextColor="{StaticResource Texto}" />
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Label Text="Aún no hay asignaturas" FontAttributes="Italic"
                                            IsVisible="{Binding SinAsignaturas}" TextColor="{StaticResource Texto}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Grid.RowSpan="3" Spacing="2"
                                    HorizontalOptions="Center" VerticalOptions="Start">
                                    <GraphicsView Drawable="{Binding Queso}" WidthRequest="84" HeightRequest="84" />

                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                        <Label Text="{Binding Correctas}" TextColor="{Binding ColorCorrectas}" FontSize="12" />
                                        <Label Text="{Binding Incorrectas}" TextColor="{Binding ColorIncorrectas}" FontSize="12" />
                                        <Label Text="{Binding SinContestar}" TextColor="{Binding ColorSinContestar}" FontSize="12" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <comp:FooterView Grid.Row="2" />

        <comp:FormularioPopup x:Name="PopupCurso" Grid.RowSpan="3" PlaceholderTitulo="Título del curso"
            Confirmado="CursoConfirmado" />
        <comp:PerfilPopup x:Name="Perfil" Grid.RowSpan="3" Guardado="PerfilGuardado" />
    </Grid>

</ContentPage>
