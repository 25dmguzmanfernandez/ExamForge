<?xml version="1.0" encoding="utf-8" ?>
<!--
  ConfigurarCuestionarioPage (ventana 6: "Realizar cuestionario"). Desde Asignaturas: casillas para elegir temas + nº de preguntas.
  Desde Tema: tema fijado, solo nº de preguntas. El botón Iniciar está en gris hasta que todo sea válido.
-->
<ContentPage x:Class="ExamForge.Views.ConfigurarCuestionarioPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:ExamForge.Views.Componentes"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    <Grid RowDefinitions="Auto,*,Auto">
        <comp:NavbarView MostrarAtras="True" AtrasClicked="CancelarClicked" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Padding="16,12" RowSpacing="10">
            <Label Text="Realizar cuestionario" Style="{StaticResource Titulo}" />
            <Label x:Name="OrigenLabel" FontAttributes="Bold" TextColor="{StaticResource Texto}" Grid.Row="1" />

            <!-- Solo cuando se abre desde la asignatura: elegir temas -->
            <CollectionView x:Name="ListaTemas"
                ItemsSource="{Binding TemasParaSeleccionar}"
                Grid.Row="2"
                SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Esta asignatura aún no tiene temas." HorizontalTextAlignment="Center"
                           TextColor="{StaticResource Texto}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Tarjeta}" Margin="0,4" Padding="10">
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    Color="{StaticResource AzulOscuro}" />
                                <Label Text="{Binding Texto}" VerticalOptions="Center" TextColor="{StaticResource Texto}" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="DisponiblesLabel"
               Grid.Row="3"
               Text="{Binding Disponibles, StringFormat='Preguntas disponibles: {0}'}"
               TextColor="{StaticResource Texto}" />

                    <VerticalStackLayout Grid.Row="4" Spacing="4">
                        <Label Text="Número de preguntas"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Texto}" />

                        <Entry x:Name="CantidadEntry"
                               Keyboard="Numeric"
                               Placeholder="Ej.: 10"
                               Text="{Binding CantidadPreguntas, Mode=TwoWay}" />

                        <Label x:Name="ErrorLabel"
                           Text="{Binding MensajeError}"
                           TextColor="{StaticResource Error}"
                           IsVisible="False" />
            </VerticalStackLayout>

            <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Cancelar" Style="{StaticResource BotonSecundario}" Clicked="CancelarClicked" />
                <Button x:Name="IniciarButton"
                        Grid.Column="1"
                        Text="Iniciar"
                        Style="{StaticResource BotonPrincipal}"
                        IsEnabled="{Binding PuedeIniciar}"
                        Command="{Binding IniciarCuestionarioCommand}" />
            </Grid>
        </Grid>

        <comp:FooterView Grid.Row="2" />
    </Grid>
</ContentPage>
