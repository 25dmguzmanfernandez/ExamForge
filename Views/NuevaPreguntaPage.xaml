<?xml version="1.0" encoding="utf-8" ?>
<!--
  NuevaPreguntaPage (ventana 5: "Creación de preguntas"). Tres pestañas: manual, generar desde texto y generar desde PDF.
  Manual: enunciado + 2 a 4 respuestas (la primera es la correcta). Las pestañas de generación están visibles pero
  la generación aún no está conectada (servicio de Gemini). GeneradasOverlay permite elegir qué preguntas generadas añadir.
  También sirve para editar una pregunta existente (solo pestaña manual).
-->
<ContentPage x:Class="ExamForge.Views.NuevaPreguntaPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:ExamForge.Views.Componentes"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    <Grid RowDefinitions="Auto,*,Auto">
        <comp:NavbarView MostrarAtras="True" AtrasClicked="AtrasClicked" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Padding="16,12" RowSpacing="10">
            <Label x:Name="TituloLabel" Text="Creación de preguntas" Style="{StaticResource Titulo}" />

            <Grid x:Name="PestanasGrid" Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <Button x:Name="PestanaManualButton" Text="Manual" Style="{StaticResource BotonPestana}" Clicked="PestanaManualClicked" />
                <Button x:Name="PestanaTextoButton" Grid.Column="1" Text="Desde texto" Style="{StaticResource BotonPestana}" Clicked="PestanaTextoClicked" />
                <Button x:Name="PestanaArchivoButton" Grid.Column="2" Text="Desde PDF" Style="{StaticResource BotonPestana}" Clicked="PestanaArchivoClicked" />
            </Grid>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="10">

                    <!-- Pestaña manual -->
                    <VerticalStackLayout x:Name="ManualPanel" Spacing="8">
                        <Label Text="Pregunta" FontAttributes="Bold" TextColor="{StaticResource Texto}" />

                        <Editor x:Name="EnunciadoEditor"
                            Text="{Binding NuevoEnunciado, Mode=TwoWay}"
                            Placeholder="Enunciado de la pregunta"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80" />

                           <Label Text="Respuestas (la primera es la correcta)"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Texto}" />

                           <Entry x:Name="Opcion1Entry"
                           Text="{Binding Opcion1, Mode=TwoWay}"
                           Placeholder="✔ Respuesta correcta" />

                           <Entry x:Name="Opcion2Entry"
                           Text="{Binding Opcion2, Mode=TwoWay}"
                           Placeholder="Respuesta 2" />

                           <Entry x:Name="Opcion3Entry"
                           Text="{Binding Opcion3, Mode=TwoWay}"
                           Placeholder="Respuesta 3"
                           IsVisible="False" />

                           <Entry x:Name="Opcion4Entry"
                           Text="{Binding Opcion4, Mode=TwoWay}"
                           Placeholder="Respuesta 4"
                           IsVisible="False" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button x:Name="MasOpcionButton" Text="+ Añadir respuesta" Style="{StaticResource BotonPequeno}" Clicked="MasOpcionClicked" />
                            <Button x:Name="MenosOpcionButton" Grid.Column="1" Text="Quitar última" IsVisible="False"
                                    Style="{StaticResource BotonPequeno}" Clicked="MenosOpcionClicked" />
                        </Grid>
                        <Label x:Name="ErrorLabel"
                           Text="{Binding MensajeError}"
                           TextColor="{StaticResource Error}"
                           IsVisible="False" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0">
                            <Button Text="Cancelar" Style="{StaticResource BotonSecundario}" Clicked="AtrasClicked" />
                            <Button Grid.Column="1" Text="Guardar" Style="{StaticResource BotonPrincipal}" Command="{Binding GuardarCommand}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Pestaña generar desde texto -->
                    <VerticalStackLayout x:Name="TextoPanel" Spacing="8" IsVisible="False">
                        <Label Text="Texto o tema del que generar preguntas" FontAttributes="Bold" TextColor="{StaticResource Texto}" />
                        <Editor x:Name="PromptEditor" Placeholder="Escribe o pega el texto…" HeightRequest="140" />
                        <Label Text="Número de preguntas" FontAttributes="Bold" TextColor="{StaticResource Texto}" />
                        <Entry x:Name="CantidadTextoEntry" Keyboard="Numeric" Text="5" />
                        <Button Text="Generar preguntas" Style="{StaticResource BotonPrincipal}" Clicked="GenerarTextoClicked" />
                    </VerticalStackLayout>

                    <!-- Pestaña generar desde PDF -->
                    <VerticalStackLayout x:Name="ArchivoPanel" Spacing="8" IsVisible="False">
                        <Label Text="Archivo PDF" FontAttributes="Bold" TextColor="{StaticResource Texto}" />
                        <Button Text="Seleccionar PDF" Style="{StaticResource BotonSecundario}" Clicked="ElegirPdfClicked" />
                        <Label x:Name="ArchivoLabel" Text="Ningún archivo seleccionado" TextColor="{StaticResource Texto}" />
                        <Label Text="Número de preguntas" FontAttributes="Bold" TextColor="{StaticResource Texto}" />
                        <Entry x:Name="CantidadArchivoEntry" Keyboard="Numeric" Text="5" />
                        <Button Text="Generar preguntas" Style="{StaticResource BotonPrincipal}" Clicked="GenerarArchivoClicked" />
                    </VerticalStackLayout>

                    <ActivityIndicator x:Name="CargandoIndicador" Color="{StaticResource AzulOscuro}" IsRunning="False" IsVisible="False" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <comp:FooterView Grid.Row="2" />

        <!-- Elegir qué preguntas generadas se añaden (todas marcadas por defecto) -->
        <Grid x:Name="GeneradasOverlay" Grid.RowSpan="3" BackgroundColor="{StaticResource Velo}" Padding="20" IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnVeloTapped" />
            </Grid.GestureRecognizers>
            <Border Style="{StaticResource Tarjeta}" BackgroundColor="White" VerticalOptions="Fill">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <Label Text="Elige las preguntas a añadir" Style="{StaticResource Titulo}" FontSize="18" />
                    <CollectionView x:Name="ListaGeneradas" Grid.Row="1" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Tarjeta}" Margin="0,4">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <CheckBox IsChecked="{Binding Seleccionado}" Color="{StaticResource AzulOscuro}" VerticalOptions="Start" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Enunciado}" FontAttributes="Bold" TextColor="{StaticResource Texto}" />
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Opciones}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Label Text="{Binding Texto}" FontSize="13" TextColor="{StaticResource Texto}" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Cancelar" Style="{StaticResource BotonSecundario}" Clicked="CancelarGeneradasClicked" />
                        <Button Grid.Column="1" Text="Añadir" Style="{StaticResource BotonPrincipal}" Clicked="AnadirGeneradasClicked" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
