<?xml version="1.0" encoding="utf-8" ?>
<!--
  BancoPreguntasPage (ventana 4: Tema). Cabecera con asignatura y tema + botón "Realizar cuestionario".
  Dos pestañas sobre el mismo panel: Banco de preguntas (cards con respuestas desplegables, crear, editar, eliminar,
  seleccionar) e Historial de exámenes (solo lectura; tocar un examen abre su revisión).
-->
<ContentPage x:Class="ExamForge.Views.BancoPreguntasPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:ExamForge.Views.Componentes"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    <Grid RowDefinitions="Auto,*,Auto">
        <comp:NavbarView MostrarAtras="True" MostrarSesion="True" AtrasClicked="AtrasClicked" PerfilClicked="PerfilClicked" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,12" RowSpacing="10">
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="4">
                    <Border BackgroundColor="{StaticResource AzulOscuro}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 8" Padding="8,1" HorizontalOptions="Start">
                        <Label x:Name="AsignaturaSiglasLabel" TextColor="White" FontAttributes="Bold" FontSize="16" />
                    </Border>
                    <Label x:Name="AsignaturaNombreLabel" MaxLines="2" LineBreakMode="WordWrap"
                           FontAttributes="Bold" TextColor="{StaticResource Texto}" />
                    <Label x:Name="TemaNombreLabel" Style="{StaticResource Titulo}" FontSize="20"
                           MaxLines="2" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Button Grid.Row="1" Text="Realizar cuestionario" Style="{StaticResource BotonPequenoAcento}"
                    HorizontalOptions="Center" Clicked="CuestionarioClicked" />

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="PestanaBancoButton" Text="Banco de preguntas" Style="{StaticResource BotonPestana}"
                        Clicked="PestanaBancoClicked" />
                <Button x:Name="PestanaHistorialButton" Grid.Column="1" Text="Historial de exámenes"
                        Style="{StaticResource BotonPestana}" Clicked="PestanaHistorialClicked" />
            </Grid>

            <!-- Pestaña 1: banco -->
            <Grid x:Name="BancoCabeceraGrid" Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="TotalPreguntasLabel" VerticalOptions="Center" TextColor="{StaticResource Texto}" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <ImageButton x:Name="EliminarSeleccionButton" Source="delete.png" IsVisible="False"
                                 WidthRequest="48" HeightRequest="40"
                                 Padding="8" Aspect="AspectFit" Clicked="EliminarSeleccionClicked" />
                    <Button Text="+" FontSize="22" WidthRequest="48"
                            Style="{StaticResource BotonPequenoAcento}" Clicked="AnadirClicked" />
                </HorizontalStackLayout>
            </Grid>

            <CollectionView x:Name="ListaPreguntas" Grid.Row="4" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Aún no se han creado preguntas…" HorizontalTextAlignment="Center" VerticalOptions="Center"
                           TextColor="{StaticResource Texto}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Tarjeta}" Margin="0,6">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Grid ColumnDefinitions="Auto,40" ColumnSpacing="0">
                                    <CheckBox Opacity="1" IsEnabled="True" CheckedChanged="SeleccionCambiada"
                                              IsChecked="{Binding Seleccionado, Mode=TwoWay}" Color="{StaticResource AzulOscuro}"
                                              VerticalOptions="Center" />
                                    <ImageButton Grid.Column="1" Source="edit.png" Clicked="EditarClicked" IsVisible="True"
                                                 WidthRequest="40" HeightRequest="40" Padding="4,8,12,8"
                                                 BackgroundColor="Transparent" Aspect="AspectFit"
                                                 VerticalOptions="Center" />
                                </Grid>
                                <Label Grid.Row="1" Text="{Binding Enunciado}" FontAttributes="Bold"
                                       TextColor="{StaticResource Texto}" />
                                <VerticalStackLayout Grid.Row="2" Spacing="6">
                                    <Button Text="{Binding TextoDesplegable, StringFormat='Respuestas {0}'}"
                                            Style="{StaticResource BotonPestana}" HorizontalOptions="Start"
                                            Clicked="DesplegarClicked" />
                                    <VerticalStackLayout IsVisible="{Binding Desplegado}"
                                                         BindableLayout.ItemsSource="{Binding Opciones}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Label Text="{Binding Texto}" TextColor="{StaticResource Texto}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Pestaña 2: historial (solo lectura) -->
            <CollectionView x:Name="ListaExamenes" Grid.Row="3" Grid.RowSpan="2" SelectionMode="None" IsVisible="False">
                <CollectionView.EmptyView>
                    <Label Text="Aún no se han realizado exámenes…" HorizontalTextAlignment="Center" VerticalOptions="Center"
                           TextColor="{StaticResource Texto}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Tarjeta}" Margin="0,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ExamenTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Texto}" />
                                    <Label Text="{Binding Fecha}" FontSize="12" TextColor="{StaticResource Texto}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding Puntuacion}" TextColor="{Binding ColorPuntuacion}"
                                       FontAttributes="Bold" FontSize="22" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <comp:FooterView Grid.Row="2" />

        <comp:PerfilPopup x:Name="Perfil" Grid.RowSpan="3" />
    </Grid>
</ContentPage>
