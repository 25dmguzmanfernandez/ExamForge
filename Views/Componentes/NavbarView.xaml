<?xml version="1.0" encoding="utf-8" ?>
<!--
  NavbarView: barra superior común (logo + nombre de la app).
  MostrarAtras="True": botón ‹ (evento AtrasClicked). MostrarSesion="True": icono de usuario (evento PerfilClicked)
  y botón Salir, que pide confirmación y devuelve al portal en estado "elegir".
-->
<ContentView x:Class="ExamForge.Views.Componentes.NavbarView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid BackgroundColor="{StaticResource AzulOscuro}" Padding="8,8" ColumnSpacing="6"
          ColumnDefinitions="Auto,*,Auto,Auto">

        <Button x:Name="AtrasButton" Text="‹" FontSize="28" TextColor="White" IsVisible="False"
                Style="{StaticResource BotonIcono}" Clicked="OnAtras" />

        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" Margin="4,0">
            <Border BackgroundColor="{StaticResource Acento}" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                    WidthRequest="34" HeightRequest="34" Padding="0">
                <Label Text="EF" FontAttributes="Bold" TextColor="{StaticResource AzulOscuro}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="ExamForge" TextColor="White" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Button x:Name="PerfilButton" Grid.Column="2" Text="👤" TextColor="White" IsVisible="False"
                Style="{StaticResource BotonIcono}" Clicked="OnPerfil" />

        <Button x:Name="SalirButton" Grid.Column="3" Text="Salir" IsVisible="False"
                Style="{StaticResource BotonPequenoAcento}" Padding="9,3" HeightRequest="34"
                MinimumWidthRequest="0" HorizontalOptions="End" Clicked="OnSalir" />
    </Grid>
</ContentView>
